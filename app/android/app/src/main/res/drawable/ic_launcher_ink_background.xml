<?xml version="1.0" encoding="utf-8"?>
<!-- Launcher background from the vector master (plate: #212227 → #1B1C21 → #17181C), plus the master's
     highlight layer. Android draws the grid at 108dp; the gradient keeps the master's
     vertical direction and the highlight its diagonal. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient android:type="linear" android:startX="0" android:startY="10.34" android:endX="0" android:endY="97.66">
                <item android:offset="0" android:color="#212227" />
                <item android:offset="0.55" android:color="#1B1C21" />
                <item android:offset="1" android:color="#17181C" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
