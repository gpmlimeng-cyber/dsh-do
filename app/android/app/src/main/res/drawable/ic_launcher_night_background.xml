    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient android:type="linear" android:startX="0" android:startY="10.34" android:endX="0" android:endY="97.66">
                <item android:offset="0" android:color="#252F56" />
                <item android:offset="0.55" android:color="#1F2849" />
                <item android:offset="1" android:color="#182040" />
            </gradient>
        </aapt:attr>
    </path>
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient android:type="linear" android:startX="27.2" android:startY="28.8" android:endX="72.8" android:endY="63.3">
                <item android:offset="0" android:color="#4DFFFFFF" />
                <item android:offset="0.55" android:color="#00FFFFFF" />
                <item android:offset="1" android:color="#00FFFFFF" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
