<?xml version="1.0" encoding="utf-8"?>
<!-- Launcher background: the 鲸耘 mint plate. The mark itself is the raster
     foreground; the plate keeps the light mint the brand artwork uses so the
     teal glyph reads the same on every launcher. -->
